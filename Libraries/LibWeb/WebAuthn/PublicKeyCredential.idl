// Experimental software-passkey stubs for Ladybird ("for the lulz").
// Not a complete WebAuthn implementation — see packages/ladybird/webauthn/README.md

enum AuthenticatorAttachment {
    "platform",
    "cross-platform"
};

dictionary AuthenticationExtensionsClientOutputs {
};

// https://w3c.github.io/webauthn/#publickeycredential
[Exposed=Window, SecureContext]
interface PublicKeyCredential : Credential {
    [SameObject] readonly attribute ArrayBuffer rawId;
    [SameObject] readonly attribute AuthenticatorResponse response;
    readonly attribute DOMString? authenticatorAttachment;
    AuthenticationExtensionsClientOutputs getClientExtensionResults();
    static Promise<boolean> isUserVerifyingPlatformAuthenticatorAvailable();
};

// Parse publicKey options as a plain object so we avoid BufferSource-in-dictionary
// codegen (not used elsewhere in LibWeb yet). SoftwarePasskeyAuthenticator digs
// challenge / rp / user out of the JS object.
partial dictionary CredentialCreationOptions {
    any publicKey;
};

partial dictionary CredentialRequestOptions {
    any publicKey;
};
